{
  "name": "@acornops/ui",
  "version": "0.0.0",
  "description": "AcornOps shared React component system replicated from the Management Console",
  "type": "module",
  "sideEffects": ["./tokens.css", "./fonts.js"],
  "files": ["dist", "tokens.css", "fonts.js", "fonts.d.ts", "tailwind-preset.js", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./tokens.css": "./tokens.css",
    "./fonts": { "types": "./fonts.d.ts", "import": "./fonts.js" },
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468.0 <1",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/ubuntu-mono": "^5.2.8",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "tailwind-merge": "^3.5.0"
  }
}
