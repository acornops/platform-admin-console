{
  "repo": "platform-admin-console",
  "version": 1,
  "runtimeDependencies": ["control-plane"],
  "counterparts": {
    "control-plane": {
      "adminBasePath": "/admin/v1",
      "adminAuth": "Internal BFF bearer credential plus a host-only human platform-admin session; neither credential is sufficient alone in production",
      "adminAuthPaths": [
        "GET /admin-auth/oidc/login",
        "GET /admin-auth/oidc/callback",
        "GET /admin-auth/csrf",
        "POST /admin-auth/logout"
      ],
      "adminAuthFailure": ["status=503", "error.code=ADMIN_IDENTITY_PROVIDER_UNAVAILABLE|ADMIN_IDENTITY_PROVIDER_MISCONFIGURED|ADMIN_SIGN_IN_UNAVAILABLE", "error.retryable", "error.request_id"],
      "platformAdminRoles": {
        "platform-admin": ["read", "write", "audit"],
        "platform-admin-viewer": ["read"],
        "platform-admin-auditor": ["audit"]
      },
      "platformAdminPaths": [
        "GET /admin/v1/me",
        "GET /admin/v1/system/readiness",
        "GET /admin/v1/system/config",
        "GET /admin/v1/system/settings",
        "PATCH /admin/v1/system/settings/{settingKey}",
        "DELETE /admin/v1/system/settings/{settingKey}",
        "GET /admin/v1/system/llm-provider-defaults",
        "PUT /admin/v1/system/llm-provider-defaults/{provider}",
        "DELETE /admin/v1/system/llm-provider-defaults/{provider}",
        "GET /admin/v1/system/workspace-defaults",
        "POST /admin/v1/system/workspace-defaults",
        "PATCH /admin/v1/system/workspace-defaults/{id}",
        "DELETE /admin/v1/system/workspace-defaults/{id}",
        "GET /admin/v1/workspaces",
        "GET /admin/v1/workspaces/{workspaceId}",
        "GET /admin/v1/workspaces/{workspaceId}/members",
        "PATCH /admin/v1/workspaces/{workspaceId}/plan",
        "POST /admin/v1/workspaces/{workspaceId}/suspend",
        "POST /admin/v1/workspaces/{workspaceId}/restore",
        "GET /admin/v1/users",
        "GET /admin/v1/users/{userId}",
        "POST /admin/v1/workspaces/{workspaceId}/members",
        "PATCH /admin/v1/workspaces/{workspaceId}/members/{userId}/role",
        "DELETE /admin/v1/workspaces/{workspaceId}/members/{userId}",
        "GET /admin/v1/admin-audit-events"
      ],
      "requiredScopes": [
        "admin:self",
        "admin:system:read",
        "admin:system:write",
        "admin:workspace:read",
        "admin:workspace:write",
        "admin:user:read",
        "admin:member:write",
        "admin:audit:read"
      ],
      "forbiddenScopes": [
        "admin:*",
        "admin:target:read",
        "admin:target:write",
        "admin:agent-key:rotate",
        "admin:run:read",
        "admin:run:write",
        "admin:tooling:write"
      ],
      "paginationShape": ["items", "nextCursor?"],
      "mutationFields": ["reason", "ticketRef?"],
      "platformSettingKeys": ["member_discovery", "ai_policy", "user_sign_in_methods", "help_links", "kubernetes_rbac_additions"],
      "platformSettingPatchFields": ["value", "expectedVersion", "reason"],
      "platformSettingResetFields": ["expectedVersion", "reason"],
      "helpLinksSetting": {
        "valueFields": ["documentationUrl", "supportUrl"],
        "defaults": ["documentationUrl=https://docs.acornops.dev", "supportUrl=https://discord.gg/jBgTy4KhF"],
        "validation": "Documentation requires credential-free HTTPS. Support requires credential-free HTTPS or a plain mailto address. Values are limited to 2048 characters.",
        "resolution": "A versioned admin override replaces the built-in product defaults. Reset removes the override and restores those defaults."
      },
      "kubernetesRbacSetting": {
        "effectiveFields": ["additions[].{key,name,description?,resources[].{apiGroup,apiVersion,resource,kind,scope,verbs[]}}"],
        "deploymentDefaultFields": ["additions[].{key,name,description?,resources[].{apiGroup,apiVersion,resource,kind,scope,verbs[]}}"],
        "overrideFields": ["upserts[].{key,name,description?,resources[].{apiGroup,apiVersion,resource,kind,scope,verbs[]}}", "disabledKeys[]"],
        "resolution": "Deployment profiles are merged with complete admin upserts by stable key, then disabled keys are removed. Changes affect future onboarding only."
      },
      "llmProviderDefaultStatusFields": ["provider", "configured", "enabled", "source=platform_default|none"],
      "llmProviderDefaultPutFields": ["apiKey(writeOnly)", "reason"],
      "llmProviderDefaultDeleteFields": ["reason"],
      "workspaceDefaultKinds": ["mcp_server", "skill"],
      "workspaceDefaultAvailability": ["agents", "kubernetes", "virtual_machines"],
      "workspaceDefaultSkillSources": ["manual", "git(pinned public GitHub/GitLab)"],
      "workspaceDefaultResponseFields": ["id", "kind", "name", "description", "availableIn(non-empty unique destination array)", "enabled", "source", "contentDigest?", "createdAt", "updatedAt"],
      "workspaceDefaultMutationFields": ["kind", "availableIn(non-empty unique destination array)", "enabled?", "immutable source", "skill files(write-only on create/import)", "reason"],
      "workspaceDefaultResolution": "A new workspace copies only enabled platform definitions and their destination arrays once during workspace creation. Disabling a definition preserves it for later re-enablement but excludes it from future workspace snapshots. Inventory resolution reads only the detached workspace snapshot; later platform changes do not affect existing workspaces. Snapshot entries appear disabled, and explicit workspace enablement creates a normal workspace-owned installation. Built-in tool catalogs are unchanged.",
      "workspacePlanPatchFields": ["planKey", "reason", "ticketRef?"],
      "workspaceSuspendFields": ["workspaceName", "reason", "ticketRef?"],
      "workspaceRestoreFields": ["workspaceName?", "reason", "ticketRef?"],
      "adminWorkspaceResponseFields": ["createdByDisplayName?", "createdByEmail?", "clusterCount", "virtualMachineCount", "memberCount", "lifecycleStatus=active|suspended", "suspendedAt?"],
      "adminUserSummaryResponseFields": ["lastLoginAt? (latest recorded password or OIDC login)"],
      "memberCreateFields": ["userId", "role", "createUserIfMissing=false", "reason", "ticketRef?"],
      "memberRolePatchFields": ["role", "reason", "ticketRef?"],
      "memberDeleteFields": ["reason", "replacementOwnerUserId?", "ticketRef?"],
      "responseCachePolicy": "All /admin/v1 responses set Cache-Control: no-store",
      "adminAuditActorFields": ["adminActorIssuer", "adminActorSubject", "adminActorEmail?", "adminActorDisplayName?", "adminActorRole", "authenticationTime"],
      "adminAuditObjectFields": ["workspaceId?", "workspaceName?", "subjectType?", "subjectId?", "subjectDisplayName?"],
      "adminAuditFilterFields": ["workspaceId? (exact, backward compatible)", "workspaceQuery? (exact ID or case-insensitive name substring)"],
      "adminAuditWritePolicy": "Authentication lifecycle events and privileged mutation requests, successes, and failures are persisted. Read-only admin requests use ordinary structured HTTP access logs and do not create admin audit records. Legacy read/search rows remain stored as append-only evidence but are excluded from Admin Audit query results.",
      "privacyProjection": "BFF removes operational workspace fields, filters admin audit to governance action families, and removes target/run identifiers before browser delivery"
    }
  }
}
