{
  "repo": "platform-admin-console",
  "version": 1,
  "runtimeDependencies": ["control-plane"],
  "counterparts": {
    "control-plane": {
      "adminBasePath": "/admin/v1",
      "adminAuth": "Internal BFF bearer credential plus a host-only human platform-admin session; neither credential is sufficient alone in production",
      "adminAuthPaths": [
        "GET /admin-auth/oidc/login",
        "GET /admin-auth/oidc/callback",
        "GET /admin-auth/csrf",
        "POST /admin-auth/logout"
      ],
      "adminAuthFailure": ["status=503", "error.code=ADMIN_IDENTITY_PROVIDER_UNAVAILABLE|ADMIN_IDENTITY_PROVIDER_MISCONFIGURED|ADMIN_SIGN_IN_UNAVAILABLE", "error.retryable", "error.request_id"],
      "platformAdminRoles": {
        "platform-admin": ["read", "write", "audit"],
        "platform-admin-viewer": ["read"],
        "platform-admin-auditor": ["audit"]
      },
      "platformAdminPaths": [
        "GET /admin/v1/me",
        "GET /admin/v1/system/readiness",
        "GET /admin/v1/system/config",
        "GET /admin/v1/system/settings",
        "PATCH /admin/v1/system/settings/{settingKey}",
        "DELETE /admin/v1/system/settings/{settingKey}",
        "GET /admin/v1/system/llm-provider-defaults",
        "PUT /admin/v1/system/llm-provider-defaults/{provider}",
        "DELETE /admin/v1/system/llm-provider-defaults/{provider}",
        "GET /admin/v1/workspaces",
        "GET /admin/v1/workspaces/{workspaceId}",
        "GET /admin/v1/workspaces/{workspaceId}/members",
        "PATCH /admin/v1/workspaces/{workspaceId}/plan",
        "POST /admin/v1/workspaces/{workspaceId}/suspend",
        "POST /admin/v1/workspaces/{workspaceId}/restore",
        "GET /admin/v1/users",
        "GET /admin/v1/users/{userId}",
        "POST /admin/v1/workspaces/{workspaceId}/members",
        "PATCH /admin/v1/workspaces/{workspaceId}/members/{userId}/role",
        "DELETE /admin/v1/workspaces/{workspaceId}/members/{userId}",
        "GET /admin/v1/admin-audit-events"
      ],
      "requiredScopes": [
        "admin:self",
        "admin:system:read",
        "admin:system:write",
        "admin:workspace:read",
        "admin:workspace:write",
        "admin:user:read",
        "admin:member:write",
        "admin:audit:read"
      ],
      "forbiddenScopes": [
        "admin:*",
        "admin:target:read",
        "admin:target:write",
        "admin:agent-key:rotate",
        "admin:run:read",
        "admin:run:write",
        "admin:tooling:write"
      ],
      "paginationShape": ["items", "nextCursor?"],
      "mutationFields": ["reason", "ticketRef?"],
      "platformSettingKeys": ["member_discovery", "ai_policy", "password_signup"],
      "platformSettingPatchFields": ["value", "expectedVersion", "reason"],
      "platformSettingResetFields": ["expectedVersion", "reason"],
      "llmProviderDefaultStatusFields": ["provider", "configured", "enabled", "source=platform_default|none"],
      "llmProviderDefaultPutFields": ["apiKey(writeOnly)", "reason"],
      "llmProviderDefaultDeleteFields": ["reason"],
      "workspacePlanPatchFields": ["planKey", "reason", "ticketRef?"],
      "workspaceSuspendFields": ["workspaceName", "reason", "ticketRef?"],
      "workspaceRestoreFields": ["workspaceName?", "reason", "ticketRef?"],
      "adminWorkspaceResponseFields": ["createdByDisplayName?", "createdByEmail?", "clusterCount", "virtualMachineCount", "memberCount", "lifecycleStatus=active|suspended", "suspendedAt?"],
      "memberCreateFields": ["userId", "role", "createUserIfMissing=false", "reason", "ticketRef?"],
      "memberRolePatchFields": ["role", "reason", "ticketRef?"],
      "memberDeleteFields": ["reason", "replacementOwnerUserId?", "ticketRef?"],
      "responseCachePolicy": "All /admin/v1 responses set Cache-Control: no-store",
      "adminAuditActorFields": ["adminActorIssuer", "adminActorSubject", "adminActorEmail?", "adminActorDisplayName?", "adminActorRole", "authenticationTime"],
      "adminAuditObjectFields": ["workspaceId?", "workspaceName?", "subjectType?", "subjectId?"],
      "privacyProjection": "BFF removes operational workspace fields, filters admin audit to governance action families, and removes target/run identifiers before browser delivery"
    }
  }
}
